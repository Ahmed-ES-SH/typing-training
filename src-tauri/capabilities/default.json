{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPCONFIG/typing_trainer.db*" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPCONFIG/typing_trainer.db" },
        { "path": "$APPCONFIG/typing_trainer.db-wal" },
        { "path": "$APPCONFIG/typing_trainer.db-shm" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPCONFIG/typing_trainer.db*" }]
    }
  ]
}
